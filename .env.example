# Phase 1 required public mobile configuration.
# EXPO_PUBLIC_* values are embedded in the app bundle and are not secrets.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Development-only Quick Login. These values are embedded in the development client and are not secrets.
# Use a dedicated disposable Supabase test account. Never use a real user or production credential.
EXPO_PUBLIC_TEST_LOGIN_EMAIL=tester@example.com
EXPO_PUBLIC_TEST_LOGIN_PASSWORD=replace-with-disposable-test-password

# Development-only catalogue dashboard. The UI flag is not authorization: the signed-in user must
# also exist in the server-managed public.catalog_developers allowlist.
EXPO_PUBLIC_ENABLE_CATALOG_DEV_TOOLS=false

# Reserved by the Phase 0 architecture; not used by Phase 1.
EXPO_PUBLIC_REVENUECAT_PUBLIC_KEY=your-revenuecat-public-sdk-key
EXPO_PUBLIC_STORAGE_BUCKET=your-storage-bucket-name

# Server-only secret. Never rename this with EXPO_PUBLIC_ or import it from mobile code.
# Configure it only in the future trusted server/edge-function environment.
OPENAI_API_KEY=your-server-only-openai-key

# Server-side synthetic catalogue tooling. Never expose the service-role key through EXPO_PUBLIC_*.
# The seed script refuses to write unless both development safety switches are set explicitly.
SUPABASE_URL=https://your-development-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-development-service-role-key
MIXANDMATCH_CATALOG_ENV=development
CATALOG_ALLOW_SYNTHETIC_SEED=false
