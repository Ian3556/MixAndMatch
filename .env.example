# Public mobile configuration. EXPO_PUBLIC_* values are embedded in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
EXPO_PUBLIC_REVENUECAT_PUBLIC_KEY=your-revenuecat-public-sdk-key
EXPO_PUBLIC_STORAGE_BUCKET=your-storage-bucket-name

# Server-only secret. Never rename this with EXPO_PUBLIC_ or import it from mobile code.
# Configure it only in the future trusted server/edge-function environment.
OPENAI_API_KEY=your-server-only-openai-key
