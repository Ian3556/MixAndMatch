{
  "expo": {
    "name": "Mix & Match",
    "slug": "mix-and-match",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mixandmatch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mixandmatch.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mixandmatch.app"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "eas": {
        "projectId": "8c0c06c3-a367-40d8-8ed3-a1ab91eced09"
      }
    }
  }
}
